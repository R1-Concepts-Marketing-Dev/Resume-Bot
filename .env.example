# Copy to .env for local runs. In GitHub Actions these come from Secrets.

# --- Google service account ---
# Paste the FULL JSON file contents on a single line, or load via file path below.
GOOGLE_SA_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"resume-bot@...iam.gserviceaccount.com",...}'

# The Workspace user the service account impersonates (resumes inbox).
GMAIL_USER=jobs@r1concepts.com

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Drive folder IDs (right-click folder in Drive → Get link → ID is the long string in the URL) ---
DRIVE_FOLDER_QUALIFIED=
DRIVE_FOLDER_NOT_QUALIFIED=
DRIVE_FOLDER_REVIEW=
DRIVE_FOLDER_INCOMING=

# --- Google Sheet (the workbook containing the Filters tab + dashboard tab) ---
SHEET_ID=
FILTERS_TAB_NAME=Filters
DASHBOARD_TAB_NAME=Candidates

# --- Behaviour toggles ---
# Gmail label applied to processed messages
PROCESSED_LABEL=resume-bot/processed
# Max messages to handle per run (safety cap)
MAX_MESSAGES_PER_RUN=25
# Claude model
ANTHROPIC_MODEL=claude-sonnet-4-5
