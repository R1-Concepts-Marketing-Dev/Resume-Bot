# Copy to .env for local runs. In GitHub Actions these come from Secrets.

# --- Google OAuth (refresh-token flow) ---
# Get these by: creating a Web-app OAuth client in GCP, adding OAuth Playground
# as a redirect URI, then signing in as jobs@ via OAuth Playground to get the
# refresh token. See README "Phase C — Get the OAuth refresh token".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Informational + used as the Gmail userId for API calls.
GMAIL_USER=jobs@r1concepts.com

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Drive folder IDs (right-click folder in Drive → Get link → ID is the long string in the URL) ---
DRIVE_FOLDER_QUALIFIED=
DRIVE_FOLDER_NOT_QUALIFIED=
DRIVE_FOLDER_REVIEW=
DRIVE_FOLDER_INCOMING=

# --- Google Sheet (the workbook containing the Filters tab + dashboard tab) ---
SHEET_ID=
FILTERS_TAB_NAME=Filters
DASHBOARD_TAB_NAME=Candidates

# --- Behaviour toggles ---
PROCESSED_LABEL=resume-bot/processed
MAX_MESSAGES_PER_RUN=25
ANTHROPIC_MODEL=claude-sonnet-4-5
